# Copy to .env. SQLite runs without Docker; switch to PostgreSQL when desired.
POSTGRES_PASSWORD=local_dev_only
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8501
DATABASE_URL=sqlite:///./data/cvti.db
ARTIFACT_DIR=./data/artifacts
# Dashboard refresh recovery files; keep under ignored data/.
WORKSPACE_STATE_DIR=./data/workspaces
CHEMBL_BASE_URL=https://www.ebi.ac.uk/chembl/api/data
OPEN_TARGETS_GRAPHQL_URL=https://api.platform.opentargets.org/api/v4/graphql
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=1
CHEMBL_MAX_RECORDS=500

# CSV job row limit; cvti start includes one local worker.
BATCH_MAX_ROWS=1000

# Optional local research assistant. Blank model leaves inference disabled.
# Use the exact installed model name shown by Ollama (including its tag).
ASSISTANT_BASE_URL=http://127.0.0.1:11434
ASSISTANT_MODEL=
ASSISTANT_TIMEOUT_SECONDS=45
